# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.edge-temp/
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Database, Migration & Local Backup files (Heavy local dumps)
backup/
*.sql
*.sqlite
*.sqlite-journal

# Prisma engine binaries & unused legacy engines
*.node
*.dll
*.tmp*
lib/prisma-client/
lib/prisma-client-v2/
lib/prisma-client-v3/

# Local village media & uploads (Stored in Cloudflare R2 in production)
/public/uploads/*
!/public/uploads/.gitkeep
/public/desa/upload/*
!/public/desa/upload/.gitkeep
