# Environment Configuration for Website Desa SaaS
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mydb"

# Platform Domain Configuration
NEXT_PUBLIC_PLATFORM_DOMAIN="localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="adit.lt"
PLATFORM_PROTOCOL="http"
# Opsional: slug tenant yang dipakai jika host tidak cocok dengan domain/subdomain mana pun.
# Kosongkan di production agar host tak dikenal menampilkan halaman "Tenant tidak ditemukan".
DEFAULT_TENANT_SLUG=""

# NextAuth / BetterAuth secret
NEXTAUTH_SECRET="your-development-or-production-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Cloudflare R2 / S3 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_DOMAIN=""
